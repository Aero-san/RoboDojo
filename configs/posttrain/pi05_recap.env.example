# Required task inputs
TASK_NAME=stack_bowls
DEMO_ROOT=/absolute/path/to/RoboDojo_lerobot_v21_video
INITIAL_POLICY_CHECKPOINT=/absolute/path/to/pi05_sft/59999

# Optional critic warm start; omit to train the first WCM from scratch.
INITIAL_WCM_CHECKPOINT=/absolute/path/to/wcm/deploy.pt

# Iterated data collection
RECAP_ITERATIONS=3
RECAP_ROLLOUT_EPISODES=50
# Selects Assets/Eval_Layout/RoboDojo/<robot>/<seed>; this stays fixed across
# iterations and is independent of the optimizer RNG seed.
RECAP_ROLLOUT_LAYOUT_SEED=0
# Set to 1, or pass --resume, to reuse every complete stage in an existing
# output root and continue the first incomplete stage.
RECAP_RESUME=0
# Score and render the first N completed rollouts after every iteration. Zero
# disables monitoring videos. Value inference uses all WCM camera views; the
# rendered background is the head camera.
RECAP_VALUE_VIDEO_EPISODES=3
RECAP_VALUE_VIDEO_GPU=0
RECAP_VALUE_VIDEO_BATCH_SIZE=8
RECAP_VALUE_VIDEO_PRECISION=bf16
RECAP_VALUE_VIDEO_BACKEND=auto
RECAP_VALUE_VIDEO_SPEED=1.0
# Keep a fixed range to make critic values visually comparable across rounds.
RECAP_VALUE_VIDEO_Y_MIN=-1.0
RECAP_VALUE_VIDEO_Y_MAX=1.0
# Iteration 1 trains from these successful demonstrations without rollout.
RECAP_MAX_DEMO_EPISODES=100
# Later WCM updates use K sampled episodes from the preceding replay prefix,
# plus every episode newly collected for the current iteration.
RECAP_WCM_REPLAY_EPISODES=20
RECAP_LOOKAHEAD=10
RECAP_GAMMA=1.0
RECAP_POSITIVE_FRACTION=0.3
RECAP_UNCONDITIONAL_PROB=0.1
# The current JAX OpenPI integration supports the official default. Scales
# other than 1 require two flow branches at every denoising step.
RECAP_GUIDANCE_SCALE=1.0
RECAP_WCM_EPOCHS=5
WCM_FAILURE_PENALTY=300

# Robot / XPolicyLab loading contract
ENV_CFG_TYPE=arx_x5
ACTION_TYPE=joint
POLICY_ENV=openpi
EVAL_ENV=RoboDojo

# Devices and optimization
# WCM launches one DDP process per WCM_TRAIN_GPUS entry. Pi0.5 uses every
# TRAIN_GPUS entry in one JAX mesh; OPENPI_FSDP_DEVICES must divide that count.
TRAIN_GPUS=0,1,2,3
WCM_TRAIN_GPUS=0,1,2,3
# Keep training GPUs reserved while replay buffers and policy datasets are
# generated. The free margin lets CUDA/NCCL initialize before the holder exits.
GPU_RESERVATION_ENABLED=1
GPU_RESERVATION_FREE_MIB=2048
OPENPI_FSDP_DEVICES=2
WCM_PER_DEVICE_BATCH_SIZE=16
RECAP_WCM_INFER_BATCH_SIZE=8

# A single rollout episode is stateful and cannot be split across GPUs. The
# policy server and Isaac Sim are separate processes, so place them separately.
POLICY_GPU=0
ENV_GPU=1
OPENPI_BATCH_SIZE=64
OPENPI_NUM_WORKERS=4
# Zero enables exact prefix-based incremental normalization. A positive value
# requests a new randomized subset and therefore recomputes it each iteration.
OPENPI_NORM_MAX_FRAMES=0
OPENPI_NORM_BATCH_SIZE=64
OPENPI_NUM_TRAIN_STEPS=10000
OPENPI_LEARNING_RATE=1.0e-5
PI05_FINETUNE_MODE=action_expert
OPENPI_WANDB_ENABLED=0

# Every iteration first collects with the current policy, then trains on all
# demonstrations and rollout rounds collected through that iteration.
