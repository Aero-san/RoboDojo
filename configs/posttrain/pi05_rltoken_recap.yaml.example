# Precedence: command line > environment > this file > launcher defaults.
TASK_NAME: stack_bowls
DEMO_ROOT: /absolute/path/to/RoboDojo_lerobot_v21_video
BASE_POLICY_CHECKPOINT: /absolute/path/to/pi05_sft/59999
INITIAL_WCM_CHECKPOINT: null
INITIAL_ACTOR_CHECKPOINT: null
OUTPUT_ROOT: outputs/rltoken_recap

RLTOKEN_RECAP_ITERATIONS: 3
RLTOKEN_RECAP_ROLLOUT_EPISODES: 40
RLTOKEN_RECAP_WCM_EPOCHS: 5
RECAP_GAMMA: 1.0
WCM_FAILURE_PENALTY: 300

RLTOKEN_OBJECTIVE: wcm_actor
RLTOKEN_ACTOR_MODE: direct
RLTOKEN_ACTOR_EPOCHS: 10
RLTOKEN_CHUNK_STEPS: 3
RLTOKEN_BATCH_SIZE: 8
RLTOKEN_ACTOR_LR: 1.0e-4
RLTOKEN_ENCODER_LR: 3.0e-4
RLTOKEN_BC_WEIGHT: 0.25

WCM_TRAIN_GPUS: 0,1,2,3
ACTOR_TRAIN_GPUS: 0,1,2,3
RLTOKEN_ROLLOUT_GPUS: 0,1,2,3
RLTOKEN_ROLLOUT_ENVS_PER_WORKER: 4
ENV_CFG_TYPE: arx_x5
ACTION_TYPE: joint
