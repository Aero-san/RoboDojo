# Unified Pi0.5 RECAP configuration. Unknown fields are rejected.
# Run with: bash scripts/posttrain/run_recap.sh --config <this-file>
schema_version: 2

policy:
  name: pi05

run:
  task: stack_bowls
  output_root: outputs/recap
  iterations: 3
  resume: false
  # Explicit recovery mode: trust structurally complete existing stages even
  # when their saved fingerprint differs from the current YAML.
  reuse_completed_artifacts: false
  seed: 0

environment:
  env_cfg: arx_x5
  action_type: joint
  policy_env: openpi
  eval_env: RoboDojo

checkpoints:
  initial_policy: /absolute/path/to/pi05_sft/59999
  initial_wcm: null

data:
  format: v2.1
  demo_root: /absolute/path/to/RoboDojo_lerobot_v21_video
  max_demo_episodes: 100
  mode: video
  norm_asset_id: null

devices:
  policy_train: [0, 1, 2, 3]
  wcm_train: [0, 1, 2, 3]
  rollout_policy: 0
  rollout_environment: 1
  value_video: 0
  reservation:
    enabled: true
    leave_free_mib: 2048
    idle_used_max_mib: 64
    local_max_hold_seconds: 1800
    remote_max_hold_seconds: 1800

rollout:
  episodes: 100
  max_steps: 40
  layout_seed: 0
  minimum:
    total: 50
    successes: 5
    failures: 5
  remote:
    enabled: false
    host: null
    repo_root: null
    work_root: null
    zstd: zstd
    conda: conda
    python: python
    policy_env: null
    eval_env: null
    policy_gpu: 0
    environment_gpu: 0
    value_video_gpu: 0
    policy_evaluation: false
    g05_root: null

training:
  # Explicit opt-in. Set host to `local` to execute on this machine, or to
  # an SSH config alias/hostname to execute on another machine.
  remote:
    enabled: false
    host: null
    repo_root: null
    work_root: null
    zstd: zstd
    conda: conda
    python: python
    policy_python: null
    wcm_python: null
    policy_gpus: [0, 1]
    wcm_gpus: [0, 1]
    value_video_gpu: 0
    render_value_video: true

wcm:
  train:
    config: configs/wcm/robodojo_pi05.yaml
    epochs: 5
    replay_episodes: 20
    per_device_batch_size: 16
    num_workers: 8
    precision: bf16
    learning_rate: null
    warmup_steps: null
    video_decoder: pyav
  inference:
    batch_size: 8
    num_workers: 2
    device: cuda

recap:
  lookahead: 10
  gamma: 1.0
  failure_penalty: 300
  positive_fraction: 0.3
  unconditional_probability: 0.1
  guidance_scale: 1.0
  sampling:
    demonstrations: 1.0
    rollouts: 1.0

pi05:
  train_config: pi05_base_aloha_full_sim_arx-x5_seed_0
  finetune_mode: action_expert_lora
  steps: 3000
  batch_size: 64
  num_workers: 4
  parameter_dtype: bfloat16
  sharding_strategy: full_shard
  fsdp_devices: 2
  cpu_offload: false
  ema_decay: 0.99
  action_expert_variant: null
  paligemma_variant: null
  xla_memory_fraction: 0.9
  wandb_enabled: true
  log_interval: 100
  optimizer:
    learning_rate: 1.0e-5
    warmup_steps: 500
    decay_lr: null
    weight_decay: 1.0e-10
    clip_gradient_norm: 1.0

evaluation:
  interval: 1000
  episodes: 20
  # Reuse this iteration's pre-training-policy rollout for the baseline;
  # candidate checkpoints still run on the rollout host.
  reuse_rollout: true
  layout_seed: 1
  layout_offset: 0

value_video:
  episodes: 3
  batch_size: 8
  device: cuda
  precision: bf16
  backend: auto
  speed: 1.0
  y_min: -1.0
  y_max: 1.0

runtime:
  policy_python: null
  data_python: XPolicyLab/policy/Pi_05/openpi/.venv/bin/python
  wcm_python: null
  policy_dir: null
