# Flat YAML keys intentionally match the established environment controls.
# Precedence: command line > environment > this file > launcher defaults.
TASK_NAME: stack_bowls
DEMO_ROOT: /absolute/path/to/RoboDojo_lerobot_v21_video
INITIAL_POLICY_CHECKPOINT: /absolute/path/to/pi05_sft/59999
INITIAL_WCM_CHECKPOINT: null
OUTPUT_ROOT: outputs/recap

RECAP_ITERATIONS: 3
RECAP_ROLLOUT_EPISODES: 50
RECAP_MAX_DEMO_EPISODES: 0
RECAP_LOOKAHEAD: 10
RECAP_GAMMA: 1.0
RECAP_POSITIVE_FRACTION: 0.3
RECAP_UNCONDITIONAL_PROB: 0.1
RECAP_GUIDANCE_SCALE: 1.0
RECAP_WCM_EPOCHS: 5
WCM_FAILURE_PENALTY: 300

OPENPI_NUM_TRAIN_STEPS: 30000
OPENPI_BATCH_SIZE: 64
OPENPI_LEARNING_RATE: 1.0e-5
OPENPI_WARMUP_STEPS: 5000
OPENPI_WEIGHT_DECAY: 1.0e-10
OPENPI_CLIP_GRADIENT_NORM: 1.0
OPENPI_WANDB_ENABLED: false

ENV_CFG_TYPE: arx_x5
ACTION_TYPE: joint
TRAIN_GPUS: 0,1,2,3
WCM_TRAIN_GPUS: 0,1,2,3
OPENPI_FSDP_DEVICES: 2
POLICY_GPU: 0
ENV_GPU: 1
