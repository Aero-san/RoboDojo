# Required
TASK_NAME=stack_bowls
DEMO_ROOT=/absolute/path/to/RoboDojo_lerobot_v21_video
BASE_POLICY_CHECKPOINT=/absolute/path/to/pi05_sft/59999

# Optional warm starts. INITIAL_ACTOR_CHECKPOINT is a full resume and cannot
# be combined with the two standalone resumes. Encoder-only resume does not
# override RLTOKEN_ACTOR_MODE or mark actor BC steps as completed.
INITIAL_WCM_CHECKPOINT=
INITIAL_ACTOR_CHECKPOINT=
RLTOKEN_ENCODER_RESUME=
RLTOKEN_BC_RESUME=

# Iterated off-policy collection
RLTOKEN_RECAP_ITERATIONS=3
RLTOKEN_RECAP_ROLLOUT_EPISODES=40
RLTOKEN_RECAP_WCM_EPOCHS=5
RECAP_GAMMA=1.0
WCM_FAILURE_PENALTY=300

# Actor initialization and WCM update. Warmup/BC run only before the first
# full actor checkpoint; later iterations restore actor, encoder and optimizer.
RLTOKEN_OBJECTIVE=wcm_actor
RLTOKEN_ENCODER_WARMUP_STEPS=1000
RLTOKEN_BC_INIT_STEPS=1000
RLTOKEN_ACTOR_EPOCHS=10
RLTOKEN_MAX_STEPS=
RLTOKEN_CHUNK_STEPS=3
RLTOKEN_TOKEN_DIM=256
RLTOKEN_ACTOR_HIDDEN_DIM=256
RLTOKEN_ACTOR_LAYERS=2
# Fresh actors default to direct action prediction so SFT behavior cloning has
# a real learning signal. Residual mode is useful only when successful replay
# samples contain executed actions different from their Pi0.5 references.
RLTOKEN_ACTOR_MODE=direct
RLTOKEN_FIXED_STD=0.04
RLTOKEN_ACTION_LOW=-5.0
RLTOKEN_ACTION_HIGH=5.0
RLTOKEN_BATCH_SIZE=8
RLTOKEN_NUM_WORKERS=2
RLTOKEN_ACTOR_LR=1.0e-4
RLTOKEN_ENCODER_LR=3.0e-4
RLTOKEN_WEIGHT_DECAY=1.0e-5
RLTOKEN_BC_WEIGHT=0.25
RLTOKEN_BASELINE_LOSS_PENALTY=1.0
RLTOKEN_WCM_VALUE_WEIGHT=1.0
RLTOKEN_RECONSTRUCTION_WEIGHT=0.01
RLTOKEN_TRAIN_ENCODER_WITH_ACTOR=0
# Stochastic actor exploration is enabled for collection. This does not alter
# normal XPolicyLab evaluation, which remains deterministic by default.
RLTOKEN_ROLLOUT_DETERMINISTIC=0

# Leave GPU lists empty to auto-detect CUDA_VISIBLE_DEVICES or nvidia-smi.
# Both PyTorch stages launch one DDP process per listed GPU.
WCM_TRAIN_GPUS=
ACTOR_TRAIN_GPUS=
# Reserve WCM/actor GPUs during CPU-only replay-buffer and dataset setup.
GPU_RESERVATION_ENABLED=1
GPU_RESERVATION_FREE_MIB=2048
WCM_PER_DEVICE_BATCH_SIZE=16

# Rollout GPUs default to ACTOR_TRAIN_GPUS and are paired in order:
# (policy, Isaac). Eight cards create four
# independent workers; 0,1,2,3 creates two. Each Isaac process vectorizes this
# many environments. An odd final GPU is left unused; one GPU runs both sides.
RLTOKEN_ROLLOUT_GPUS=
RLTOKEN_ROLLOUT_ENVS_PER_WORKER=4
ENV_CFG_TYPE=arx_x5
ACTION_TYPE=joint
POLICY_ENV=openpi
EVAL_ENV=RoboDojo
